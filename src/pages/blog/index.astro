---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { slug: 'marginalia', title: 'Marginalia', date: '' },
  { slug: 'charting_a_course', title: 'Charting a Course', date: '' },
];
---
<Layout title="Writing — Tejas Prabhune">
  <div class="stack">
    <h1>Writing</h1>

    <ul class="posts">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          {post.date && <span> — {post.date}</span>}
        </li>
      ))}
    </ul>
  </div>
</Layout>
