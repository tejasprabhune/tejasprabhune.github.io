---
import Layout from '../layouts/Layout.astro';

const pubs = [
  {
    title: 'Multimodal Pretraining for Vocal Tract Modeling',
    authors: [['Tejas S. Prabhune', true], ['Bohan Yu', false], ['Rishi Jain', false], ['Peter Wu', false], ['Gopala K. Anumanchipalli', false]],
    venue: 'Paper pending, 2024',
    href: 'https://arxiv.org/pdf/2310.16287',
    media: { type: 'video', src: '/images/mri.mp4' },
  },
  {
    title: 'Towards Streaming Speech-to-Avatar Synthesis',
    authors: [['Tejas S. Prabhune', true], ['Peter Wu', false], ['Bohan Yu', false], ['Gopala K. Anumanchipalli', false]],
    venue: 'ASRU Demo, 2023',
    href: 'https://arxiv.org/pdf/2310.16287',
    media: { type: 'video', src: '/images/demo_short_vowels.mp4' },
  },
  {
    title: 'Contrastive learning-based pretraining improves representation and transferability of diabetic retinopathy classification models',
    authors: [['Minhaj Nur Alam', false], ['Rikiya Yamashita', false], ['Vignav Ramesh', false], ['Tejas S. Prabhune', true], ['Jennifer I. Lim', false], ['Robison Vernon Paul Chan', false], ['Joelle Hallak', false], ['Theodore Leng', false], ['Daniel Rubin', false]],
    venue: 'Nature Scientific Reports, 2023',
    href: 'https://www.nature.com/articles/s41598-023-33365-y',
    media: { type: 'image', src: '/images/diabetic_retinopathy.webp' },
  },
  {
    title: 'Dataset-Agnostic Vessel Segmentation of Retinal Fundus Images by a Vector Quantized Variational Autoencoder',
    authors: [['Tejas S. Prabhune', true], ['David Walz', false]],
    venue: 'Journal of Student Research, 2021',
    href: 'https://www.jsr.org/hs/index.php/path/article/download/2280/887',
    media: { type: 'image', src: '/images/seg.png' },
  },
];
---
<Layout title="Research — Tejas Prabhune" description="Publications by Tejas Prabhune">
  <div class="stack">
    <h1>Research</h1>

    <p>
      I studied EECS at UC Berkeley and worked at the Berkeley Speech Group inside
      Berkeley Artificial Intelligence Research (BAIR), advised by Dr. Gopala K.
      Anumanchipalli, Peter Wu, Cheol Jun Cho, and Jiachen Lian. My work there covered
      visualizing the vocal tract with speech-driven 3D avatars, brain-computer
      interfaces for virtual embodiment, and generating realistic audio-visual dialogue
      with avatar-based LLMs.
    </p>

    <p>
      <a href="mailto:prabhune@berkeley.edu">Email</a>,
      <a href="/data/TejasPrabhuneResume.pdf">Resume</a>,
      <a href="https://scholar.google.com/citations?user=QI1zl84AAAAJ" target="_blank" rel="noopener">Google Scholar</a>
    </p>

    <ul class="pubs">
      {pubs.map(pub => (
        <li>
          <p>
            <span class="title">{pub.title}</span><br>
            {pub.authors.map(([name, isMe], i) => (
              <>
                {i > 0 && ', '}
                {isMe ? <strong>{name}</strong> : name}
              </>
            ))}<br>
            {pub.venue}. <a href={pub.href} target="_blank" rel="noopener">Paper</a>
          </p>
          {pub.media.type === 'video'
            ? <video class="media" src={pub.media.src} muted autoplay loop playsinline></video>
            : <img class="media" src={pub.media.src} alt="" loading="lazy" />}
        </li>
      ))}
    </ul>
  </div>
</Layout>
