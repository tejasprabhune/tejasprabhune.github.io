---
import Layout from '../layouts/Layout.astro';

const things = [
  {
    name: 'sim francisco',
    desc: 'modeling distributionally accurate city simulations.',
    links: [{ label: 'simfrancisco.org', href: 'https://simfrancisco.org' }],
  },
  {
    name: 'Wispr',
    desc: 'post-trained and deployed multilingual models.',
    links: [{ label: 'wisprflow.ai', href: 'https://wisprflow.ai' }],
  },
  {
    name: 'Machine Learning @ Berkeley',
    desc: 'ex-president (Sp26), ex-VP of Education (Fa25).',
    links: [{ label: 'ml.berkeley.edu', href: 'https://ml.berkeley.edu' }],
  },
  {
    name: 'CS 189/289 (Intro to Machine Learning)',
    desc: 'lead TA twice. Made the homeworks for information theory, transformers, diffusion, and flow matching.',
    links: [],
  },
  {
    name: 'Research',
    desc: 'speech-driven 3D avatars of the vocal tract, brain-computer interfaces for virtual embodiment, and audio-visual dialogue from avatar-based LLMs at the Berkeley Speech Group. Contrastive pretraining for diabetic retinopathy classification at SAIL. Published in ASRU (2023) and Nature Scientific Reports (2023).',
    links: [
      { label: 'Publications', href: '/research' },
      { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=QI1zl84AAAAJ&hl=en' },
    ],
  },
  {
    name: 'NPDA Debate',
    desc: 'NPTE Champion 2026.',
    links: [
      { label: 'npdadebate.com', href: 'https://npdadebate.com/' },
      { label: 'goldenturn.org', href: 'https://goldenturn.org/' },
    ],
  },
];
---
<Layout title="Tejas Prabhune">
  <div class="stack">
    <h1>Tejas Prabhune</h1>

    <p>
      I'm a big fan of machine learning, systems, economics, social science,
      debate, painting, and table tennis. Working on something new! I love
      meeting new people, so please reach out and we can grab coffee :)
    </p>

    <ul class="contact">
      <li><a href="mailto:prabhune@berkeley.edu">prabhune@berkeley.edu</a></li>
      <li><a href="https://twitter.com/tejas_prabhune" target="_blank" rel="noopener">@tejas_prabhune</a></li>
    </ul>

    <div>
      <button class="disclosure" type="button" aria-expanded="false" aria-controls="things-drawer">
        Prior work
      </button>

      <div class="drawer" id="things-drawer" data-open="false">
        <div>
          <ul class="things">
            {things.map(thing => (
              <li>
                <span class="name">{thing.name}</span>: {thing.desc}
                {thing.links.map((link, i) => (<>{i > 0 ? ', ' : ' '}<a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener' : undefined}>{link.label}</a></>))}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('.disclosure');
  const drawer = document.getElementById('things-drawer');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    drawer?.setAttribute('data-open', String(!open));
  });
</script>
