---
import Layout from '../../layouts/Layout.astro';

const API = import.meta.env.PUBLIC_CANON_API ?? 'https://tejas-life-api.fly.dev';
---
<Layout title="Editor: Tejas Prabhune" wide>
  <div id="gate" class="stack" data-api={API}>
    <h1>Editor</h1>
    <form id="password-form">
      <input type="password" id="password" placeholder="password" autocomplete="current-password">
      <button type="submit">unlock</button>
      <span id="password-error"></span>
    </form>
  </div>

  <div id="studio" hidden>
    <div id="editor-bar">
      <a href="/writing/">writing</a>
      <select id="post-select"></select>
      <input type="text" id="post-title" placeholder="Title">
      <span id="post-slug" class="muted"></span>
      <button type="button" id="save">save draft</button>
      <button type="button" id="preview-post">preview</button>
      <button type="button" id="publish">publish</button>
      <button type="button" id="unpublish" hidden>unpublish</button>
      <button type="button" id="delete-post">delete</button>
      <button type="button" id="vim-toggle">vim: on</button>
      <span id="editor-status"></span>
    </div>
    <div id="image-strip" hidden></div>
    <div id="panes">
      <div id="editor-pane"></div>
      <div id="preview-pane">
        <div id="preview"></div>
        <pre id="diagnostics" hidden></pre>
      </div>
    </div>
  </div>
</Layout>

<script>
  const gate = document.getElementById('gate')!;
  const API = gate.dataset.api!;
  const PASSWORD_KEY = 'canon-password';

  const studio = document.getElementById('studio')!;
  const postSelect = document.getElementById('post-select') as HTMLSelectElement;
  const titleInput = document.getElementById('post-title') as HTMLInputElement;
  const slugLabel = document.getElementById('post-slug')!;
  const saveButton = document.getElementById('save') as HTMLButtonElement;
  const previewButton = document.getElementById('preview-post') as HTMLButtonElement;
  const publishButton = document.getElementById('publish') as HTMLButtonElement;
  const unpublishButton = document.getElementById('unpublish') as HTMLButtonElement;
  const deleteButton = document.getElementById('delete-post') as HTMLButtonElement;
  const statusLabel = document.getElementById('editor-status')!;
  const preview = document.getElementById('preview')!;
  const previewPane = document.getElementById('preview-pane')!;
  const diagnostics = document.getElementById('diagnostics')!;

  // Math uses typst's default New Computer Modern Math; the serif font is
  // preloaded below. The sans variant stays available for an explicit
  // #show math.equation: set text(font: "New Computer Modern Sans Math").
  const TEMPLATE = `#set page(width: 16cm, height: auto, margin: (x: 0.2cm, top: 0.2cm, bottom: 0.8cm), fill: white)
#set text(font: "Neue Montreal", size: 11pt, fill: black)
#set par(leading: 0.75em)
#import "/side.typ": side, side-appendix

`;

  // Sidenotes: #side[...] renders a superscript number and records the
  // marker's position for the published page's margin rail. The appendix
  // lists every note and is appended to live preview compiles only.
  const SIDE_LIB = `#let side-notes = state("side-notes", ())
#let side-count = counter("side-note")

#let side(body) = {
  side-count.step()
  side-notes.update(s => s + (body,))
  context {
    let n = side-count.get().first()
    super(str(n))
    [#metadata((n: n, pos: here().position())) <side-note>]
  }
}

#let side-appendix = context {
  let notes = side-notes.final()
  if notes.len() > 0 {
    v(2em)
    line(length: 30%, stroke: 0.5pt + luma(60%))
    v(0.6em)
    set text(size: 9pt)
    for (i, note) in notes.enumerate() {
      [#super(str(i + 1)) #note]
      parbreak()
    }
  }
}
`;

  const NOTE_PREAMBLE = `#set page(width: 5.4cm, height: auto, margin: 0.1cm, fill: white)
#set text(font: "Neue Montreal", size: 8.5pt, fill: black)
#set par(leading: 0.65em)

`;

  type Meta = {
    id: string;
    slug: string;
    title: string;
    status: 'draft' | 'published';
    updated_at: string;
  };
  type Post = Meta & { source: string; svg: string | null; published_at: string | null };

  let password: string | null = sessionStorage.getItem(PASSWORD_KEY);
  let posts: Meta[] = [];
  let current: Post | null = null;
  let savedDoc = '';
  let savedTitle = '';
  const dirtyImages = new Set<string>();
  const imageBlobs = new Map<string, { bytes: Uint8Array; type: string; id?: string }>();
  const imageStrip = document.getElementById('image-strip')!;

  let view: any = null;
  let typst: any = null;

  function setStatus(text: string, isError = false) {
    statusLabel.textContent = text;
    statusLabel.style.color = isError ? '#B00020' : '';
  }

  async function api(path: string, options: RequestInit = {}) {
    const headers = new Headers(options.headers);
    if (password) headers.set('x-canon-password', password);
    const response = await fetch(`${API}${path}`, { ...options, headers });
    if (!response.ok) {
      const body = await response.json().catch(() => ({ error: response.statusText }));
      throw new Error(body.error ?? 'request failed');
    }
    return response.status === 204 ? null : response.json();
  }

  const slugify = (title: string) =>
    title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'untitled';

  const autosaveKey = () => `writing-autosave-${current?.id ?? 'new'}`;

  function docText(): string {
    return view ? view.state.doc.toString() : '';
  }

  function setDoc(text: string) {
    view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: text } });
  }

  function unsaved() {
    return docText() !== savedDoc || titleInput.value !== savedTitle;
  }

  function updateButtons() {
    const published = current?.status === 'published';
    publishButton.textContent = published ? 'republish' : 'publish';
    unpublishButton.hidden = !published;
  }

  // Live preview. Compiles are queued so a keystroke during a compile
  // schedules exactly one follow-up run.
  let compiling = false;
  let compileAgain = false;
  let compileTimer: ReturnType<typeof setTimeout> | undefined;

  function compileSoon() {
    clearTimeout(compileTimer);
    compileTimer = setTimeout(() => void compile(), 250);
  }

  // The main file lives at a fixed path so image("/images/...") paths
  // resolve against the shadow filesystem the pasted images are mapped into.
  async function compileSvg(extra = ''): Promise<string> {
    await typst.$typst.addSource('/main.typ', docText() + extra);
    return typst.$typst.svg({ mainFilePath: '/main.typ' });
  }

  async function compile() {
    if (compiling) {
      compileAgain = true;
      return;
    }
    compiling = true;
    do {
      compileAgain = false;
      try {
        const withAppendix = docText().includes('side-appendix');
        const svg = await compileSvg(withAppendix ? '\n#side-appendix\n' : '');
        const scroll = previewPane.scrollTop;
        preview.innerHTML = svg;
        previewPane.scrollTop = scroll;
        diagnostics.hidden = true;
        trackCursorHook?.();
      } catch (error) {
        diagnostics.textContent = formatDiagnostics(error);
        diagnostics.hidden = false;
      }
    } while (compileAgain);
    compiling = false;
  }

  // Set once the editor has booted; scrolls the preview to the cursor.
  let trackCursorHook: (() => void) | null = null;

  function formatDiagnostics(error: unknown): string {
    if (Array.isArray(error)) {
      return error
        .map(d => (typeof d === 'string' ? d : d?.message ?? JSON.stringify(d)))
        .join('\n');
    }
    if (error instanceof Error) return error.message;
    return String(error);
  }

  function refreshSelect() {
    postSelect.innerHTML = '';
    const fresh = document.createElement('option');
    fresh.value = '';
    fresh.textContent = 'new post';
    postSelect.append(fresh);

    for (const status of ['draft', 'published'] as const) {
      const group = document.createElement('optgroup');
      group.label = status === 'draft' ? 'Drafts' : 'Published';
      for (const post of posts.filter(p => p.status === status)) {
        const option = document.createElement('option');
        option.value = post.id;
        option.textContent = post.title;
        group.append(option);
      }
      if (group.children.length) postSelect.append(group);
    }
    postSelect.value = current?.id ?? '';
  }

  async function refreshPosts() {
    posts = await api('/api/writing/all');
    refreshSelect();
  }

  async function resetImages() {
    imageBlobs.clear();
    dirtyImages.clear();
    await typst.$typst.resetShadow();
    await typst.$typst.addSource('/side.typ', SIDE_LIB);
    renderImageStrip();
  }

  function renderImageStrip() {
    imageStrip.innerHTML = '';
    imageStrip.hidden = imageBlobs.size === 0;
    for (const [filename] of imageBlobs) {
      const chip = document.createElement('span');
      chip.className = 'image-chip';
      chip.append(filename);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.title = `delete ${filename}`;
      remove.addEventListener('click', () => void deleteImage(filename));
      chip.append(remove);
      imageStrip.append(chip);
    }
  }

  async function deleteImage(filename: string) {
    if (!confirm(`Delete ${filename}? References to it in the text will stop compiling.`)) return;
    const image = imageBlobs.get(filename);
    try {
      if (image?.id) {
        await api(`/api/writing/images/${image.id}`, { method: 'DELETE' });
      }
      imageBlobs.delete(filename);
      dirtyImages.delete(filename);
      await typst.$typst.unmapShadow(`/images/${filename}`);
      renderImageStrip();
      compileSoon();
    } catch (error) {
      setStatus((error as Error).message, true);
    }
  }

  async function openNew() {
    current = null;
    await resetImages();
    titleInput.value = '';
    slugLabel.textContent = '';
    setDoc(TEMPLATE);
    savedDoc = docText();
    savedTitle = '';
    updateButtons();
    refreshSelect();
    restoreAutosave();
    void compile();
  }

  async function openPost(id: string) {
    setStatus('loading…');
    const post: Post = await api(`/api/writing/posts/${id}`);
    current = post;
    await resetImages();

    const images: { id: string; filename: string; content_type: string }[] =
      await api(`/api/writing/posts/${id}/images`);
    for (const image of images) {
      const response = await fetch(`${API}/api/writing/images/${image.id}`, {
        headers: password ? { 'x-canon-password': password } : {},
      });
      if (!response.ok) continue;
      const bytes = new Uint8Array(await response.arrayBuffer());
      imageBlobs.set(image.filename, { bytes, type: image.content_type, id: image.id });
      await typst.$typst.mapShadow(`/images/${image.filename}`, bytes);
    }
    renderImageStrip();

    titleInput.value = post.title;
    slugLabel.textContent = `/${post.slug}`;
    setDoc(post.source);
    savedDoc = docText();
    savedTitle = post.title;
    updateButtons();
    refreshSelect();
    setStatus('');
    restoreAutosave();
    void compile();
  }

  function writeAutosave() {
    try {
      localStorage.setItem(
        autosaveKey(),
        JSON.stringify({ title: titleInput.value, source: docText(), at: Date.now() }),
      );
    } catch {
      // Storage full or blocked; the server copy is the real save anyway.
    }
  }

  function restoreAutosave() {
    try {
      const raw = localStorage.getItem(autosaveKey());
      if (!raw) return;
      const saved = JSON.parse(raw);
      const serverAt = current ? new Date(current.updated_at).getTime() : 0;
      if (saved.at > serverAt && saved.source !== docText()) {
        if (confirm('Restore unsaved local changes for this post?')) {
          titleInput.value = saved.title ?? titleInput.value;
          setDoc(saved.source);
        } else {
          localStorage.removeItem(autosaveKey());
        }
      }
    } catch {
      // A malformed autosave is not worth surfacing.
    }
  }

  async function save(): Promise<boolean> {
    const title = titleInput.value.trim();
    if (!title) {
      setStatus('title required', true);
      titleInput.focus();
      return false;
    }
    setStatus('saving…');
    try {
      if (!current) {
        current = await api('/api/writing/posts', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title, slug: slugify(title), source: docText() }),
        });
      } else {
        current = await api(`/api/writing/posts/${current.id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title, source: docText() }),
        });
      }

      for (const filename of [...dirtyImages]) {
        const image = imageBlobs.get(filename);
        if (!image) continue;
        const form = new FormData();
        form.append('file', new Blob([image.bytes.buffer as ArrayBuffer], { type: image.type }), filename);
        const meta = await api(`/api/writing/posts/${current!.id}/images`, { method: 'POST', body: form });
        image.id = meta.id;
        dirtyImages.delete(filename);
      }

      savedDoc = docText();
      savedTitle = titleInput.value;
      slugLabel.textContent = `/${current!.slug}`;
      localStorage.removeItem(autosaveKey());
      await refreshPosts();
      setStatus(`saved ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`);
      return true;
    } catch (error) {
      setStatus((error as Error).message, true);
      return false;
    }
  }

  function extractSideBodies(source: string): string[] {
    const bodies: string[] = [];
    const re = /#side\s*\[/g;
    let match;
    while ((match = re.exec(source))) {
      const start = re.lastIndex;
      let depth = 1;
      let i = start;
      while (i < source.length && depth > 0) {
        if (source[i] === '[') depth += 1;
        else if (source[i] === ']') depth -= 1;
        i += 1;
      }
      if (depth === 0) bodies.push(source.slice(start, i - 1));
      re.lastIndex = i;
    }
    return bodies;
  }

  // Each sidenote becomes its own narrow SVG, paired with the position of
  // its superscript marker in the main document.
  async function buildSidenotes(source: string) {
    if (!/#side\s*\[/.test(source)) return [];
    const compiler = await typst.$typst.getCompiler();
    const marks: any[] = await compiler.runWithWorld(
      { mainFilePath: '/main.typ' },
      async (world: any) => {
        await world.compile({});
        return world.query({ selector: '<side-note>', field: 'value' });
      },
    );
    const bodies = extractSideBodies(source);
    const notes = [];
    for (const mark of marks) {
      const body = bodies[mark.n - 1];
      if (body == null) continue;
      await typst.$typst.addSource('/note.typ', NOTE_PREAMBLE + body.trim() + '\n');
      const noteSvg = await typst.$typst.svg({ mainFilePath: '/note.typ' });
      notes.push({
        n: mark.n,
        x: parseFloat(String(mark.pos.x)),
        y: parseFloat(String(mark.pos.y)),
        svg: noteSvg,
      });
    }
    return notes;
  }

  async function publish() {
    if (!(await save())) return;
    setStatus('publishing…');
    try {
      const svg = await compileSvg();
      const notes = await buildSidenotes(docText());
      current = await api(`/api/writing/posts/${current!.id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ svg, status: 'published', notes }),
      });
      updateButtons();
      await refreshPosts();
      setStatus('published');
    } catch (error) {
      setStatus(formatDiagnostics(error), true);
    }
  }

  // Renders the draft the way the published page will show it and opens
  // it in a preview tab that reads the payload from localStorage.
  async function openPreview() {
    setStatus('rendering preview…');
    try {
      const svg = await compileSvg();
      const notes = await buildSidenotes(docText());
      localStorage.setItem(
        'writing-preview',
        JSON.stringify({ title: titleInput.value.trim() || 'Untitled', svg, notes, at: Date.now() }),
      );
      window.open('/writing/preview/', 'writing-preview');
      setStatus('');
    } catch (error) {
      setStatus(formatDiagnostics(error), true);
    }
  }

  async function unpublish() {
    if (!current || current.status !== 'published') return;
    if (!confirm(`Unpublish "${current.title}"?`)) return;
    setStatus('unpublishing…');
    try {
      current = await api(`/api/writing/posts/${current.id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ status: 'draft' }),
      });
      updateButtons();
      await refreshPosts();
      setStatus('unpublished');
    } catch (error) {
      setStatus((error as Error).message, true);
    }
  }

  async function deletePost() {
    if (!current) {
      await openNew();
      return;
    }
    if (!confirm(`Delete "${current.title}"?`)) return;
    try {
      await api(`/api/writing/posts/${current.id}`, { method: 'DELETE' });
      localStorage.removeItem(autosaveKey());
      current = null;
      await refreshPosts();
      await openNew();
      setStatus('deleted');
    } catch (error) {
      setStatus((error as Error).message, true);
    }
  }

  function nextImageName(extension: string) {
    let n = 1;
    while (imageBlobs.has(`img-${n}.${extension}`)) n += 1;
    return `img-${n}.${extension}`;
  }

  async function pasteImage(file: File) {
    const bytes = new Uint8Array(await file.arrayBuffer());
    const extension = file.type === 'image/jpeg' ? 'jpg' : file.type === 'image/gif' ? 'gif' : 'png';
    const filename = nextImageName(extension);

    imageBlobs.set(filename, { bytes, type: file.type || 'image/png' });
    dirtyImages.add(filename);
    await typst.$typst.mapShadow(`/images/${filename}`, bytes);
    renderImageStrip();

    const pos = view.state.selection.main.head;
    const line = view.state.doc.lineAt(pos);
    const needsBreak = pos > line.from ? '\n' : '';
    const snippet = `${needsBreak}#figure(\n  image("/images/${filename}", width: 80%),\n  caption: [],\n)\n`;
    view.dispatch({
      changes: { from: pos, insert: snippet },
      selection: { anchor: pos + snippet.length },
    });
    view.focus();
    compileSoon();
  }

  async function boot() {
    gate.hidden = true;
    studio.hidden = false;
    setStatus('loading editor…');

    const [codemirror, vimMode, typstLang, cmLanguage, cmState, cmView, cmCommands, snippet, typstFs, compilerWasm, rendererWasm] =
      await Promise.all([
        import('codemirror'),
        import('@replit/codemirror-vim'),
        import('codemirror-lang-typst/lezer'),
        import('@codemirror/language'),
        import('@codemirror/state'),
        import('@codemirror/view'),
        import('@codemirror/commands'),
        import('@myriaddreamin/typst.ts/dist/esm/contrib/snippet.mjs'),
        import('@myriaddreamin/typst.ts/dist/esm/fs/index.mjs'),
        import('@myriaddreamin/typst-ts-web-compiler/pkg/typst_ts_web_compiler_bg.wasm?url'),
        import('@myriaddreamin/typst-ts-renderer/pkg/typst_ts_renderer_bg.wasm?url'),
      ]);

    typst = snippet;
    const { $typst, TypstSnippet } = snippet;
    $typst.setCompilerInitOptions({ getModule: () => compilerWasm.default });
    $typst.setRendererInitOptions({ getModule: () => rendererWasm.default });
    $typst.use(
      TypstSnippet.withAccessModel(new typstFs.MemoryAccessModel()),
      TypstSnippet.disableDefaultFontAssets(),
      TypstSnippet.preloadFonts([
        '/fonts/NeueMontreal-Regular.otf',
        '/fonts/NeueMontreal-Medium.otf',
        '/fonts/NeueMontreal-Italic.otf',
        '/fonts/NeueMontreal-MediumItalic.otf',
        '/fonts/NewCMMath-Regular.otf',
        '/fonts/NewCMSansMath-Regular.otf',
        '/fonts/DejaVuSansMono.ttf',
      ]),
    );
    await $typst.addSource('/side.typ', SIDE_LIB);

    const { basicSetup, EditorView } = codemirror;
    const { vim, Vim } = vimMode;

    Vim.defineEx('write', 'w', () => void save());

    // Vim keybinds are off by default on touch devices and small screens,
    // where there is no real keyboard to drive them.
    const mobile =
      window.matchMedia('(pointer: coarse)').matches ||
      window.matchMedia('(max-width: 800px)').matches;
    let vimOn = !mobile;
    const vimCompartment = new cmState.Compartment();
    const vimToggle = document.getElementById('vim-toggle') as HTMLButtonElement;

    function applyVim() {
      vimToggle.textContent = `vim: ${vimOn ? 'on' : 'off'}`;
      view?.dispatch({ effects: vimCompartment.reconfigure(vimOn ? vim() : []) });
    }

    vimToggle.textContent = `vim: ${vimOn ? 'on' : 'off'}`;
    vimToggle.addEventListener('click', () => {
      vimOn = !vimOn;
      applyVim();
      view.focus();
    });

    // Auto-close typst's symmetric delimiters: $math$, *strong* and _emph_.
    // The syntax tree decides where each one makes sense, so _ stays a plain
    // subscript in math and * stays multiplication in code.
    const MARKUP_NODES = new Set([
      'Markup', 'Text', 'Strong', 'Emph', 'Heading', 'ListItem', 'EnumItem',
      'TermItem', 'ContentBlock', 'Link', 'SmartQuote', 'Parbreak',
    ]);
    const MATH_NODES = new Set([
      'Equation', 'Math', 'MathText', 'MathIdent', 'MathCall', 'MathArgs',
      'MathDelimited', 'MathAttach', 'MathFrac', 'MathRoot', 'MathPrimes',
      'MathShorthand', 'MathFieldAccess', 'MathAlignPoint',
    ]);
    const VERBATIM_NODES = new Set(['Raw', 'Str', 'LineComment', 'BlockComment']);
    const CODE_NODES = new Set([
      'Code', 'CodeBlock', 'Args', 'Parenthesized', 'Array', 'Dict', 'FuncCall',
      'LetBinding', 'SetRule', 'ShowRule', 'Binary', 'Unary', 'Closure', 'Params',
      'Conditional', 'WhileLoop', 'ForLoop', 'Contextual', 'ModuleImport',
      'ModuleInclude', 'ImportItems', 'Named', 'Keyed', 'Spread',
    ]);

    function contextAt(state: any, pos: number): 'markup' | 'math' | 'code' | 'verbatim' {
      let node = cmLanguage.syntaxTree(state).resolveInner(pos, -1);
      for (; node; node = node.parent) {
        if (MARKUP_NODES.has(node.name)) return 'markup';
        if (MATH_NODES.has(node.name)) return 'math';
        if (VERBATIM_NODES.has(node.name)) return 'verbatim';
        if (CODE_NODES.has(node.name)) return 'code';
      }
      return 'markup';
    }

    const typstPairs = EditorView.inputHandler.of((editorView: any, _from: number, _to: number, text: string) => {
      if (text !== '$' && text !== '*' && text !== '_') return false;
      const state = editorView.state;

      if (state.selection.ranges.some((r: any) => !r.empty)) {
        editorView.dispatch(
          state.changeByRange((range: any) => ({
            changes: [{ from: range.from, insert: text }, { from: range.to, insert: text }],
            range: cmState.EditorSelection.range(range.anchor + 1, range.head + 1),
          })),
          { userEvent: 'input.type', scrollIntoView: true },
        );
        return true;
      }

      const pos = state.selection.main.head;
      const prev = pos > 0 ? state.doc.sliceString(pos - 1, pos) : '';
      const next = state.doc.sliceString(pos, pos + 1);
      if (prev === '\\') return false;

      // Typing the delimiter right before an identical one closes it.
      if (next === text) {
        editorView.dispatch({ selection: { anchor: pos + 1 }, scrollIntoView: true, userEvent: 'select' });
        return true;
      }

      const context = contextAt(state, pos);
      const closeOk = next === '' || /[\s)\]}.,;:!?"']/.test(next);
      let pair = false;
      if (text === '$') {
        pair = (context === 'markup' || context === 'code') && closeOk;
      } else {
        const openOk = prev === '' || /[\s([{~"'\-–—]/.test(prev);
        // On a #expression line the parse may not yet cover what is being
        // typed, so a delimiter after a number or operator (say #let x = 2 *)
        // reads as code continuing, not as the start of emphasis.
        const line = state.doc.lineAt(pos);
        const before = state.doc.sliceString(line.from, pos);
        const anchorChar = before.trimEnd().slice(-1);
        const codeish =
          /^\s*#/.test(line.text) &&
          before !== before.trimEnd() &&
          /[0-9=+*/<>,)]/.test(anchorChar);
        pair = context === 'markup' && openOk && closeOk && !codeish;
      }
      if (!pair) return false;

      editorView.dispatch({
        changes: { from: pos, insert: text + text },
        selection: { anchor: pos + 1 },
        scrollIntoView: true,
        userEvent: 'input.type',
      });
      return true;
    });

    view = new EditorView({
      doc: TEMPLATE,
      parent: document.getElementById('editor-pane')!,
      extensions: [
        vimCompartment.of(vimOn ? vim() : []),
        typstPairs,
        basicSetup,
        cmView.keymap.of([cmCommands.indentWithTab]),
        typstLang.typst_lezer(),
        cmLanguage.syntaxHighlighting(typstLang.TypstHighlightSytle),
        EditorView.lineWrapping,
        EditorView.updateListener.of((update: any) => {
          if (update.docChanged) {
            compileSoon();
            writeAutosave();
          }
        }),
      ],
    });

    savedDoc = docText();
    savedTitle = '';

    // Preview cursor tracking. A copy of the source gets an invisible
    // metadata marker at the nearest safe markup position above the cursor;
    // querying its rendered position tells us where to scroll the preview.
    const TRACK_MARK = '#context [#metadata(here().position()) <cursor-track>]';

    function trackInjectPos(state: any): number {
      const doc = state.doc;
      let lineNo = doc.lineAt(state.selection.main.head).number;
      for (; lineNo >= 1; lineNo--) {
        const line = doc.line(lineNo);
        if (!line.text.trim() || /\\\s*$/.test(line.text)) continue;
        if (contextAt(state, line.to) === 'markup') return line.to;
      }
      return -1;
    }

    function scrollPreviewToPt(yPt: number) {
      const svgEl = preview.querySelector('svg');
      if (!svgEl) return;
      const vb = (svgEl as any).viewBox?.baseVal;
      if (!vb || !vb.height) return;
      const svgRect = svgEl.getBoundingClientRect();
      const paneRect = previewPane.getBoundingClientRect();
      const yPx =
        svgRect.top - paneRect.top + previewPane.scrollTop + (yPt / vb.height) * svgRect.height;
      const lo = previewPane.scrollTop + previewPane.clientHeight * 0.15;
      const hi = previewPane.scrollTop + previewPane.clientHeight * 0.85;
      if (yPx >= lo && yPx <= hi) return;
      previewPane.scrollTo({
        top: Math.max(0, yPx - previewPane.clientHeight * 0.4),
        behavior: 'smooth',
      });
    }

    let tracking = false;
    let trackAgain = false;
    async function trackCursor() {
      if (tracking) {
        trackAgain = true;
        return;
      }
      tracking = true;
      do {
        trackAgain = false;
        await trackCursorOnce();
      } while (trackAgain);
      tracking = false;
    }

    async function trackCursorOnce() {
      try {
        const state = view.state;
        const injectPos = trackInjectPos(state);
        if (injectPos < 0) {
          scrollPreviewToPt(0);
          return;
        }
        const source = state.doc.toString();
        const tracked = source.slice(0, injectPos) + TRACK_MARK + source.slice(injectPos);
        await typst.$typst.addSource('/track.typ', tracked);
        // The snippet's own query() forgets to compile the world first, so
        // drive the world directly.
        const compiler = await typst.$typst.getCompiler();
        const found: any[] = await compiler.runWithWorld(
          { mainFilePath: '/track.typ' },
          async (world: any) => {
            await world.compile({});
            return world.query({ selector: '<cursor-track>', field: 'value' });
          },
        );
        const position = found?.[0];
        if (!position || position.page !== 1) return;
        const yPt = parseFloat(String(position.y));
        if (Number.isFinite(yPt)) scrollPreviewToPt(yPt);
      } catch {
        // The marker can land in an unparseable spot mid-edit; tracking
        // simply skips that keystroke.
      }
    }

    trackCursorHook = () => void trackCursor();

    document.getElementById('editor-pane')!.addEventListener(
      'paste',
      event => {
        const files = event.clipboardData?.files;
        const file = files && [...files].find(f => f.type.startsWith('image/'));
        if (!file) return;
        event.preventDefault();
        event.stopPropagation();
        void pasteImage(file);
      },
      { capture: true },
    );

    titleInput.addEventListener('input', writeAutosave);
    saveButton.addEventListener('click', () => void save());
    previewButton.addEventListener('click', () => void openPreview());
    publishButton.addEventListener('click', () => void publish());
    unpublishButton.addEventListener('click', () => void unpublish());
    deleteButton.addEventListener('click', () => void deletePost());

    postSelect.addEventListener('change', async () => {
      if (unsaved() && !confirm('Discard unsaved changes?')) {
        postSelect.value = current?.id ?? '';
        return;
      }
      if (postSelect.value) await openPost(postSelect.value);
      else await openNew();
    });

    window.addEventListener('keydown', event => {
      if ((event.metaKey || event.ctrlKey) && event.key === 's') {
        event.preventDefault();
        void save();
      }
    });

    window.addEventListener('beforeunload', event => {
      if (unsaved()) event.preventDefault();
    });

    try {
      await refreshPosts();
    } catch (error) {
      setStatus((error as Error).message, true);
    }
    setStatus('');
    restoreAutosave();
    view.focus();
    void compile();
  }

  // Password gate, sharing the reading page's session unlock.
  const passwordForm = document.getElementById('password-form') as HTMLFormElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const passwordError = document.getElementById('password-error')!;

  async function verify(candidate: string): Promise<boolean> {
    try {
      const response = await fetch(`${API}/api/canon/verify`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password: candidate }),
      });
      return response.ok;
    } catch {
      return false;
    }
  }

  passwordForm.addEventListener('submit', async event => {
    event.preventDefault();
    passwordError.textContent = '';
    if (await verify(passwordInput.value)) {
      password = passwordInput.value;
      sessionStorage.setItem(PASSWORD_KEY, password);
      passwordInput.value = '';
      void boot();
    } else {
      passwordError.textContent = 'wrong password';
    }
  });

  if (password) {
    verify(password).then(ok => {
      if (ok) {
        void boot();
      } else {
        sessionStorage.removeItem(PASSWORD_KEY);
        password = null;
        passwordInput.focus();
      }
    });
  } else {
    passwordInput.focus();
  }
</script>
