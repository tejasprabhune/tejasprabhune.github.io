---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  post?: boolean;
}

const { title, description = 'Tejas Prabhune', wide = false, post = false } = Astro.props;

const links = [
  { href: '/', label: 'Index' },
  { href: '/research', label: 'Research' },
  { href: '/reading', label: 'Reading' },
  { href: '/writing', label: 'Writing' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="light">
</head>
<body>
  <main class={wide ? 'wide' : post ? 'post' : undefined}>
    <slot />
  </main>

  <footer>
    <nav>
      {links.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
  </footer>
</body>
</html>
